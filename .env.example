# ==============================================================================
# OSMOO Environment Configuration Template (.env.example)
# Copy this file to .env.local for local development.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# --- Frontend Client Configuration (Exposed to browser via Vite) ---
# Supabase Project URL (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon / Publishable Key (Safe for browser code with RLS enabled)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key

# Application Base URL for OAuth/Auth return redirects
VITE_APP_BASE_URL=http://localhost:5173

# --- Backend Serverless Functions Configuration (Vercel / Server Only) ---
# CRITICAL: DO NOT prefix these with VITE_. They must remain server-side only.

# Supabase Service Role Key (High privilege, strictly server-side for admin ops)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend API Key for transactional notification emails (optional/on-demand)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=OSMOO <notifications@osmoo.in>

# Dodo Payments Integration (Test or Live)
# Environment: 'test_mode' or 'live_mode'
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=dodo_api_key_test_or_live
DODO_PAYMENTS_WEBHOOK_SECRET=whsec_your_dodo_webhook_secret

# Production Domain Target
APP_BASE_URL=https://osmoo.in
